{
  "name": "patchiri-site",
  "version": "0.0.0",
  "private": true,
  "description": "patchiri のドキュメントとデモ（Astro + Starlight）。デモはブラウザの中の PostgreSQL（PGlite）で動く。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/sync-docs.mjs && astro dev",
