{
  "name": "harikit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/server-node",
    "packages/cli"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/server-node packages/cli",
    "test": "npm run build && node --test \"packages/*/dist/test/**/*.test.js\"",
    "clean": "tsc -b --clean packages/core packages/server-node packages/cli",
    "test:dotnet": "npm run build && node --test packages/server-dotnet/test/webmethod.integration.test.mjs"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
