{
  "name": "patchiri-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/web",
    "packages/server-node",
    "packages/cli",
    "site"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/web packages/server-node packages/cli && npm run bundle -w patchiri-web",
    "test": "npm run build && node --test \"packages/*/dist/test/**/*.test.js\"",
    "clean": "tsc -b --clean packages/core packages/web packages/server-node packages/cli",
    "test:dotnet": "npm run build && node --test packages/server-dotnet/test/webmethod.integration.test.mjs",
    "build:site": "tsc -b packages/core packages/web packages/server-node && npm run bundle -w patchiri-web && npm run build -w patchiri-site",
    "test:site": "npm test -w patchiri-site"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "@types/oracledb": "^6.10.4",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3"
  }
}
